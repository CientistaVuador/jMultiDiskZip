              <AuxValues>
                <AuxValue name="JavaCodeGenerator_InitCodePost" type="java.lang.String" value="this.fileList.setTransferHandler(new FileDragAndDrop() {&#xd;&#xa;    @Override&#xd;&#xa;    protected boolean process(List&lt;File&gt; files) {&#xd;&#xa;        DefaultListModel&lt;String&gt; model = (DefaultListModel&lt;String&gt;) fileList.getModel();&#xd;&#xa;        for (File f:files) {&#xd;&#xa;            String s = f.toString();&#xd;&#xa;            if (!model.contains(s)) {&#xd;&#xa;                model.addElement(s);&#xd;&#xa;            }&#xd;&#xa;        }&#xd;&#xa;        return true;&#xd;&#xa;    }&#xd;&#xa;});&#xd;&#xa;"/>
                <AuxValue name="JavaCodeGenerator_TypeParameters" type="java.lang.String" value="&lt;String&gt;"/>
              </AuxValues>
